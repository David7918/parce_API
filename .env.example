# Environment variables for Parce
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# Your LlamaCloud API key — obtain from https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=llx-your-api-key-here

# Directory where parsed Markdown files will be saved.
# Defaults to ./output if not set.
OUTPUT_DIR=./output
